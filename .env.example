# Django settings
SECRET_KEY='change-me'

# Database
DATABASE_URL=postgres://user:password@localhost:5432/db

# Redis cache: TTL'd keys only, allkeys-lru
REDIS_URL='redis://localhost:6379/0'

# Broker instance (noeviction, AOF): Celery and the bot's FSM. Defaults shown.
# CELERY_BROKER_URL='redis://localhost:6379/1'
# CELERY_RESULT_BACKEND='redis://localhost:6379/2'
# TELEGRAM_FSM_REDIS_URL='redis://localhost:6379/3'

# Public base URL of the web app, no trailing slash. Used where there is no
# HTTP request to derive the host from — the bot building sign-in links.
SITE_URL='http://localhost:8000'

# Telegram Bot
TELEGRAM_BOT_TOKEN=''
# Bot @name without the @, for the t.me deep links that connect an account.
TELEGRAM_BOT_USERNAME=''
TELEGRAM_WEBHOOK_URL=''
TELEGRAM_WEBHOOK_SECRET=''
# Support group id (negative, e.g. -100...); the bot must be a member.
TELEGRAM_SUPPORT_CHAT_ID=
# Shown to users when the support relay is down, e.g. '@handle'.
TELEGRAM_SUPPORT_CONTACT=''

# Google AI
GOOGLE_AI_KEY=''

# Email (Gmail SMTP)
EMAIL_HOST_USER=''
EMAIL_HOST_PASSWORD=''
DEFAULT_FROM_EMAIL=''

# Local media go to the filesystem unless this is true
USE_R2=false

# Cloudflare R2 (same as AWS S3)
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_STORAGE_BUCKET_NAME=''
AWS_S3_ENDPOINT_URL='https://<account-id>.r2.cloudflarestorage.com'
